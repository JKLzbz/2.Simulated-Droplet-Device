          <mxGeometry x="720" y="420" width="460" height="300" as="geometry" />
        </mxCell>

        <mxCell id="pump" value="气泵 / 气动引擎蓄压&#xa;功率：0~1023（SPEED）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff6b81;fontSize=12;spacing=8;" vertex="1" parent="1">
