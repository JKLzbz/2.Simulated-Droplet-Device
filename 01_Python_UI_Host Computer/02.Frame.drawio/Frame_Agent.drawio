        <mxCell id="esp32" value="发生端 MCU：ESP32&#xa;TCP Server:80（接收控制指令）&#xa;指令：SPEED / PUMP_ON/OFF / ATOM_TOGGLE / VALVE_TOGGLE / COUGH_PERFECT / STOP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#fa983a;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="230" width="460" height="160" as="geometry" />
        </mxCell>

