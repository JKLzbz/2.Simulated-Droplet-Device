        <mxCell id="net" value="局域网 / Wi‑Fi（TCP）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4b7bec;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="1440" height="70" as="geometry" />
        </mxCell>

        <!-- PC / Host -->
        <mxCell id="pc" value="上位机（PC）&#xa;Python UI：DualDragonTerminal&#xa;控制：连接 ESP32:80&#xa;监测：监听 0.0.0.0:8080（STM32 上报）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f3542;fontSize=13;spacing=10;" vertex="1" parent="1">
